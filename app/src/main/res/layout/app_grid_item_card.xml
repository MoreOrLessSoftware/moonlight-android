<?xml version="1.0" encoding="utf-8"?>
<!-- Box art on the left, the app name and its settings overrides on the right.
     The grid stretches cards to fill its columns, so the width here is only a fallback. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="147dp"
    android:padding="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="@drawable/app_card_background">
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="123dp">
            <ImageView
                android:id="@+id/grid_image"
                android:cropToPadding="false"
                android:scaleType="fitXY"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_image_mask"
                android:clipToOutline="true">
            </ImageView>
            <!-- Only shown over the placeholder when there's no box art -->
            <TextView
                android:id="@+id/grid_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:gravity="center"
                android:textSize="13sp">
            </TextView>
            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp">
            </ImageView>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textStyle="bold"
                android:textSize="17sp">
            </TextView>
            <TextView
                android:id="@+id/card_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:visibility="gone">
            </TextView>
        </LinearLayout>
    </LinearLayout>
    <!-- Shown around the running app's card -->
    <View
        android:id="@+id/running_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/app_card_running_border"
        android:visibility="gone" />
</FrameLayout>
