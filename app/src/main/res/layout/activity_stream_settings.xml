<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".preferences.StreamSettings">

    <!-- Tabs for each page of settings -->
    <LinearLayout
        android:id="@+id/settings_tabs"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settings_tab_video"
            style="@style/SettingsTab"
            android:drawableTop="@drawable/ic_settings_video"
            android:text="@string/settings_tab_video" />

        <TextView
            android:id="@+id/settings_tab_audio"
            style="@style/SettingsTab"
            android:drawableTop="@drawable/ic_settings_audio"
            android:text="@string/settings_tab_audio" />

        <TextView
            android:id="@+id/settings_tab_input"
            style="@style/SettingsTab"
            android:drawableTop="@drawable/ic_settings_input"
            android:text="@string/settings_tab_input" />

        <TextView
            android:id="@+id/settings_tab_other"
            style="@style/SettingsTab"
            android:drawableTop="@drawable/ic_settings_other"
            android:text="@string/settings_tab_other" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/stream_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
